#| label: configuration
# ============================================================================
# USER CONFIGURATION - MODIFY THIS SECTION
# ============================================================================
# Analysis polarity: "pos" or "neg"
POLARITY <- "pos"
# Data source: "local", "sqlite", or "metaboLights"
# - "local": Load from local .mzML files in POS_data/ or NEG_data/
# - "sqlite": Load from pre-built SQLite database (faster for repeated analyses)
# - "metaboLights": Download directly from MetaboLights repository (MTBLS10722)
DATA_SOURCE <- "local"
# MetaboLights study ID (only used if DATA_SOURCE = "metaboLights")
MTBLS_ID <- "MTBLS10722"
# SQLite database path (only used if DATA_SOURCE = "sqlite")
# Will be auto-generated based on polarity if not specified
SQLITE_DB <- NULL  # e.g., "NEG_data/pilot_neg.sqlite"
# Number of CPU cores for parallel processing (use 1-2 below your max)
CORES_NB <- 4
# Retention time filter range (seconds) - adjust based on your BPC
RT_FILTER_MIN <- 10
RT_FILTER_MAX <- 920  # Use 800 for negative mode typically
# Chromatographic peak detection parameters
PEAK_WIDTH <- c(4, 8)  # min and max peak width in seconds
PPM <- 10              # m/z tolerance in ppm
SN_THRESHOLD <- 2      # signal-to-noise threshold
# Matching parameters
MATCH_PPM <- 20        # ppm for database matching
MATCH_RT_TOL <- 20     # RT tolerance in seconds for matching
ISOPEAK_SIM_THRESHOLD <- 0.78  # minimum isotope pattern similarity
# QC filtering
RSD_THRESHOLD <- 0.3   # 30% RSD threshold for QC filtering
# Volume correction factors (specific to this study)
VOLUME_FACTORS <- list(
"W" = 2.5,    # W-DBS: smaller volume injected
"P" = 1.08    # Plasma: slight adjustment
)
#| label: filter-rt
# Filter based on retention time
mse <- filterRt(mse, c(RT_FILTER_MIN, RT_FILTER_MAX))
#| label: bpc-filtered
#| fig-cap: "BPC after retention time filtering"
plot_bpc(mse, palette = palette_sample_type,
main = "BPC - After RT Filtering")
#| label: load-is
#| tbl-cap: "Reference lipids for RT correction"
# Load and prepare internal standard data
intern_standard <- prepare_reference_lipids(
IS_FILE,
rt_window_left = 30,
rt_window_right = ifelse(POLARITY == "pos", 15, 20)
)
# Extract EICs
eic_is <- extract_is_eics(mse, intern_standard)
fdata <- fData(eic_is)
# Display table
kable(intern_standard[, c("short_name", "mz", "RT")], format = "pipe")
#| label: plot-is-eics
# Save EIC plots for all reference lipids
plot_eic_batch(eic_is, fdata, palette = palette_sample_type,
output_dir = folders$eic_istd)
#| label: peak-detection-params
# Define peak detection parameters
param_pd <- CentWaveParam(
peakwidth = PEAK_WIDTH,
ppm = PPM,
integrate = 2,
snthresh = SN_THRESHOLD,
firstBaselineCheck = FALSE
)
param_pd
#| label: run-peak-detection
# Run peak detection on entire dataset
mse <- findChromPeaks(mse, param = param_pd, chunkSize = CORES_NB)
# Update EICs with peak detection results
eic_is <- extract_is_eics(mse, intern_standard)
fData(eic_is) <- fdata
#| label: peaks-per-sample
#| tbl-cap: "Number of chromatographic peaks detected per sample"
# Summarize peaks per sample
data.frame(
sample_name = sampleData(mse)$sample_name,
peak_count = as.integer(table(chromPeaks(mse)[, "sample"]))
) |> t() |> kable(format = "pipe")
#| label: save-peak-detection-plots
# Save peak detection result plots
plot_eic_batch(eic_is, fdata, palette = palette_sample_type,
output_dir = folders$peak_detection)
#| label: rt-alignment
# Initial correspondence for alignment (based on QC samples)
QC_samples <- sampleData(mse)$sample_type == "QC"
param_c <- PeakDensityParam(
sampleGroups = QC_samples,
minFraction = 0.9,
binSize = 0.01, ppm = PPM,
bw = 2
)
mse <- groupChromPeaks(mse, param = param_c)
# Perform alignment
subset_idx <- which(QC_samples)
param_align <- PeakGroupsParam(
minFraction = 0.9,
extraPeaks = 50,
span = 0.5,
subsetAdjust = "average",
subset = subset_idx
)
mse <- adjustRtime(mse, param = param_align)
#| label: plot-alignment
#| fig-cap: "Retention time alignment results"
# Visualize alignment
col_sample <- get_sample_colors(sampleData(mse)$sample_type, palette_sample_type)
plotAdjustedRtime(mse, col = paste0(col_sample, "80"), peakGroupsPch = 1)
grid()
legend("topright", col = palette_sample_type,
legend = names(palette_sample_type), lty = 1, bty = "n")
#| label: apply-alignment
# Keep raw data for comparison, then apply alignment
mse_raw <- dropAdjustedRtime(mse)
mse <- applyAdjustedRtime(mse)
#| label: correspondence
# Define sample groups (QCs as NA)
group_mse <- sampleData(mse)$sample_type
group_mse[group_mse == "QC"] <- NA
group_mse <- as.factor(group_mse)
# Correspondence parameters
param_cor <- PeakDensityParam(
sampleGroups = group_mse,
minFraction = 0.5,
binSize = 0.01,
ppm = PPM,
bw = 2
)
# Run correspondence
mse <- groupChromPeaks(mse, param = param_cor)
message("Correspondence complete: ", nrow(featureDefinitions(mse)), " features")
#| label: gap-filling
# Check missing values before
na_before <- sum(is.na(featureValues(mse))) / length(featureValues(mse)) * 100
# Fill missing values
mse <- fillChromPeaks(mse, param = ChromPeakAreaParam(), chunkSize = CORES_NB)
# Check missing values after
na_after <- sum(is.na(featureValues(mse))) / length(featureValues(mse)) * 100
message("Gap filling: ", round(na_before, 1), "% -> ", round(na_after, 1), "% NA")
# Warning for high initial NA percentage
if (na_before > 50) {
warning("High initial missing value percentage (", round(na_before, 1),
"%). Consider reviewing peak detection parameters or sample quality.")
}
#| label: extract-results
# Extract as SummarizedExperiment
res <- quantify(mse, method = "sum", filled = FALSE)
assays(res)$raw_filled <- featureValues(mse, method = "sum", filled = TRUE)
#| label: load-preprocessed
#| eval: false
source("R/lipid_helpers.R")
load_lipid_packages(verbose = TRUE)
folders <- setup_folders(polarity = POLARITY)
# mse_save_path <- file.path(folders$objects, paste0("preprocessed_mse_", POLARITY))
#res_save_path <- file.path(folders$objects, paste0("preprocessed_res_", POLARITY))
# Load mse: .RData file (from SQLite workflow) or Alabaster directory
if (file.exists(paste0(mse_save_path, ".RData"))) {
load(paste0(mse_save_path, ".RData"))  # loads 'mse'
} else {
mse <- readMsObject(XcmsExperiment(), AlabasterParam(path = mse_save_path))
}
#| label: save-preprocessed
#| eval: true
# Save preprocessed objects
mse_save_path <- file.path(folders$objects,
paste0("preprocessed_mse_", POLARITY))
res_save_path <- file.path(folders$objects,
paste0("preprocessed_res_", POLARITY))
# If SQLite backend is used, convert to in-memory before saving
if (DATA_SOURCE == "sqlite") {
spectra(mse) <- setBackend(spectra(mse), MsBackendMemory())
save(mse, file = paste0(mse_save_path, ".RData"))
} else {
saveMsObject(mse, AlabasterParam(path = mse_save_path))
}
res@metadata <- list()
saveObject(res, res_save_path)
#| label: load-preprocessed
#| eval: false
source("R/lipid_helpers.R")
load_lipid_packages(verbose = TRUE)
folders <- setup_folders(polarity = POLARITY)
mse_save_path <- file.path(folders$objects, paste0("preprocessed_mse_", POLARITY))
res_save_path <- file.path(folders$objects, paste0("preprocessed_res_", POLARITY))
# Load mse: .RData file (from SQLite workflow) or Alabaster directory
if (file.exists(paste0(mse_save_path, ".RData"))) {
load(paste0(mse_save_path, ".RData"))  # loads 'mse'
} else {
mse <- readMsObject(XcmsExperiment(), AlabasterParam(path = mse_save_path))
}
res <- readObject(res_save_path)
# # Reload internal standards
intern_standard <- prepare_reference_lipids(IS_FILE)
eic_is <- extract_is_eics(mse, intern_standard)
fdata <- fData(eic_is)
message("✓ Loaded preprocessed objects")
#| label: rt-correction-fit
#| fig-cap: "RT correction model diagnostic plots"
# Prepare grouping parameter
group <- eic_is$sample_type
group[group == "QC"] <- NA
group <- as.factor(group)
param_group <- PeakDensityParam(
sampleGroups = group,
minFraction = 0.5,
binSize = 0.01, ppm = PPM, bw = 2
)
# Fit RT correction model
rt_fit <- fit_rt_correction(
eic_is, intern_standard, param_group,
poly_degree = 6,
output_dir = folders$ref_lipid
)
# Display model summary
summary(rt_fit$fit)
#| label: load-database
lipid_database <- prepare_lipid_database(
db_path = "LipidDatabase_R.xlsx",
sheet = DB_SHEET,
polarity = POLARITY,
rt_col = RT_COL,
rt_fit = rt_fit
)
#| label: plot-rt-correction
#| fig-cap: "Database RT vs. adjusted RT with reference lipids overlay"
# Plot RT correction results
plot(y = lipid_database$rt_sd, x = lipid_database$rt_adjusted, type = "l",
xlab = "Adjusted RT", ylab = "Database RT")
points(intern_standard$RT ~ rt_fit$exp_rt, col = "red", pch = 16, cex = 1)
abline(v = min(rt_fit$fit$fitted.values), col = "blue", lwd = 1, lty = 2)
abline(v = max(rt_fit$fit$fitted.values), col = "blue", lwd = 1, lty = 2)
grid()
abline(0, 1, lty = 2, col = "#00000040")
legend("topleft", legend = c("Database compounds", "Reference lipids"),
col = c("black", "red"), lty = c(1, NA), pch = c(NA, 16), bty = "n")
#| label: rank1-matching
match_result <- match_features_to_database(
res,
lipid_database,
ppm = MATCH_PPM,
rt_tol = MATCH_RT_TOL
)
mtched_data <- match_result$mtched_data
query <- match_result$query
lipid_db_r1 <- match_result$lipid_db_r1
#| label: isotope-validation
# Calculate isotope pattern similarity
iso_result <- calculate_isotope_similarity(
mse, mtched_data, polarity = POLARITY,
isopeak_threshold = 2,
similarity_threshold = ISOPEAK_SIM_THRESHOLD
)
mtched_data <- iso_result$mtched_data
message("Matches after isotope filter: ", nrow(mtched_data))
#| label: plot-isotope-patterns
# Save isotope pattern comparison plots
plot_isotope_patterns(
mtched_data,
iso_result$iso_spectra,
iso_result$theoretical_spectra,
folders$iso_pattern
)
