"W-DBS" = "#E41A1C",
"C-qDBS" = "#4DAF4A",
"Plasma" = "#984EA3"
)
)
# You can create additional palettes for other columns, e.g.:
# palette_batch <- create_color_palette(mse, column = "batch")
# palette_donor <- create_color_palette(mse, column = "donor_id", palette = "Set2")
# Display the palette
message("Color palette for sample_type:")
print(palette_sample_type)
#| label: bpc-raw
#| fig-cap: "Base Peak Chromatogram (BPC) of all samples colored by sample type"
# Plot BPC
plot_bpc(mse, palette = palette_sample_type, main = "BPC - All Samples")
#| label: filter-rt
# Filter based on retention time
mse <- filterRt(mse, c(RT_FILTER_MIN, RT_FILTER_MAX))
#| label: bpc-filtered
#| fig-cap: "BPC after retention time filtering"
plot_bpc(mse, palette = palette_sample_type,
main = "BPC - After RT Filtering")
#| label: load-is
#| tbl-cap: "Reference lipids for RT correction"
# Load and prepare internal standard data
intern_standard <- prepare_reference_lipids(
IS_FILE,
rt_window_left = 30,
rt_window_right = ifelse(POLARITY == "pos", 15, 20)
)
# Extract EICs
eic_is <- extract_is_eics(mse, intern_standard)
fdata <- fData(eic_is)
# Display table
kable(intern_standard[, c("short_name", "mz", "RT")], format = "pipe")
#| label: plot-is-eics
# Save EIC plots for all reference lipids
plot_eic_batch(eic_is, fdata, palette = palette_sample_type,
output_dir = folders$eic_istd)
#| label: peak-detection-params
# Define peak detection parameters
param_pd <- CentWaveParam(
peakwidth = PEAK_WIDTH,
ppm = PPM,
integrate = 2,
snthresh = SN_THRESHOLD,
firstBaselineCheck = FALSE
)
param_pd
#| label: run-peak-detection
# Run peak detection on entire dataset
mse <- findChromPeaks(mse, param = param_pd, chunkSize = CORES_NB)
# Update EICs with peak detection results
eic_is <- extract_is_eics(mse, intern_standard)
fData(eic_is) <- fdata
#| label: peaks-per-sample
#| tbl-cap: "Number of chromatographic peaks detected per sample"
# Summarize peaks per sample
data.frame(
sample_name = sampleData(mse)$sample_name,
peak_count = as.integer(table(chromPeaks(mse)[, "sample"]))
) |> t() |> kable(format = "pipe")
#| label: save-peak-detection-plots
# Save peak detection result plots
plot_eic_batch(eic_is, fdata, palette = palette_sample_type,
output_dir = folders$peak_detection)
knitr::opts_chunk$set(echo = TRUE, fig.width = 10, fig.height = 6)
#| label: configuration
# ============================================================================
# USER CONFIGURATION - MODIFY THIS SECTION
# ============================================================================
# Analysis polarity: "pos" or "neg"
POLARITY <- "pos"
# Data source: "local", "sqlite", or "metaboLights"
# - "local": Load from local .mzML files in POS_data/ or NEG_data/
# - "sqlite": Load from pre-built SQLite database (faster for repeated analyses)
# - "metaboLights": Download directly from MetaboLights repository (MTBLS10722)
DATA_SOURCE <- "local"
# MetaboLights study ID (only used if DATA_SOURCE = "metaboLights")
MTBLS_ID <- "MTBLS10722"
# SQLite database path (only used if DATA_SOURCE = "sqlite")
# Will be auto-generated based on polarity if not specified
SQLITE_DB <- NULL  # e.g., "NEG_data/pilot_neg.sqlite"
# Number of CPU cores for parallel processing (use 1-2 below your max)
CORES_NB <- 4
# Retention time filter range (seconds) - adjust based on your BPC
RT_FILTER_MIN <- 10
RT_FILTER_MAX <- 800  # Use 800 for negative mode typically
# Chromatographic peak detection parameters
PEAK_WIDTH <- c(4, 8)  # min and max peak width in seconds
PPM <- 10              # m/z tolerance in ppm
SN_THRESHOLD <- 2      # signal-to-noise threshold
# Matching parameters
MATCH_PPM <- 20        # ppm for database matching
MATCH_RT_TOL <- 20     # RT tolerance in seconds for matching
ISOPEAK_SIM_THRESHOLD <- 0.78  # minimum isotope pattern similarity
# QC filtering
RSD_THRESHOLD <- 0.3   # 30% RSD threshold for QC filtering
# Volume correction factors (specific to this study)
VOLUME_FACTORS <- list(
"W" = 2.5,    # W-DBS: smaller volume injected
"P" = 1.08    # Plasma: slight adjustment
)
#| label: load-helpers
# Source helper functions
source("R/lipid_helpers.R")
# Load all required packages
load_lipid_packages(verbose = TRUE)
#| label: setup-folders
# Create folder structure based on polarity
folders <- setup_folders(polarity = POLARITY)
# Define file paths based on polarity
if (POLARITY == "pos") {
SEQ_FILE <- "seq_pos.xlsx"
IS_FILE <- "splashlipidomix_list.xlsx"
DB_SHEET <- 4L
DATA_SUFFIX <- "_pos.mzML"
RT_COL <- "RT ESI(+) (min)"
} else {
SEQ_FILE <- "seq_neg.xlsx"
IS_FILE <- "neg_splashlipidomix_list.xlsx"
DB_SHEET <- 5L
DATA_SUFFIX <- "_neg.mzML"
RT_COL <- "RT ESI(–) (min)"
}
# Setup parallel processing
if (.Platform$OS.type == "unix") {
register(MulticoreParam(CORES_NB))
} else {
register(SnowParam(CORES_NB))
}
#| label: load-data
# Load sample sequence
seq_data <- read_xlsx(SEQ_FILE, col_names = TRUE) |> as.data.frame()
seq_data$polarity <- POLARITY
if (DATA_SOURCE == "local") {
# ---- OPTION 1: Load from local mzML files ----
message("Loading data from local mzML files...")
spectra_files <- file.path(folders$data, seq_data$file_name)
# Check files exist
missing_files <- spectra_files[!file.exists(spectra_files)]
if (length(missing_files) > 0) {
stop("Missing files:\n", paste(missing_files, collapse = "\n"))
}
mse <- readMsExperiment(spectraFiles = spectra_files, sampleData = seq_data)
} else if (DATA_SOURCE == "sqlite") {
# ---- OPTION 2: Load from SQLite database ----
# To create a database from mzML files first, run: source("R/create_sqlite_database.R")
# Use provided path or default based on polarity
if (is.null(SQLITE_DB)) {
SQLITE_DB <- file.path(folders$data, paste0("pilot_", POLARITY, ".sqlite"))
}
mse <- load_from_sqlite(SQLITE_DB, seq_data)
} else if (DATA_SOURCE == "metaboLights") {
# ---- OPTION 3: Load from MetaboLights ----
# This loads data directly from the MetaboLights repository.
# You need to configure the column_mapping for your specific study.
# Define assay name based on polarity (specific to MTBLS10722)
assay_name <- if (POLARITY == "pos") {
"a_MTBLS10722_LC-MS_positive_reverse-phase_metabolite_profiling.txt"
} else {
"a_MTBLS10722_LC-MS_negative_reverse-phase_metabolite_profiling.txt"
}
# Column mapping for MTBLS10722 - adjust for other studies
# To find column names, visit: https://www.ebi.ac.uk/metabolights/{MTBLS_ID}
# and examine the assay file chosen above (a_*.txt)
mtbls_column_mapping <- list(
sample_name = "Sample Name",
file_name = "Raw Spectral Data File",
sample_type = "Factor Value[Sample type]",
injection_index = "Comment[injection_index]"
)
mse <- load_from_metaboLights(
mtbls_id = MTBLS_ID,
assay_name = assay_name,
column_mapping = mtbls_column_mapping,
filter_column = "Factor Value[Cohort]",
filter_value = "Cohort_study",
exclude_sample_types = "Blank",
polarity = POLARITY
)
} else {
stop("Invalid DATA_SOURCE: '", DATA_SOURCE, "'. Use 'local', 'sqlite', or 'metaboLights'.")
}
message("✓ Loaded ", length(mse), " samples")
sampleData(mse)
#| label: setup-colors
# Create palette for sample_type (default for most plots)
# Uses predefined colors for known sample types, auto-generates for others
palette_sample_type <- create_color_palette(
mse,
column = "sample_type",
custom_colors =
c("QC" = "#999999",
"M-VAMS" = "#377EB8",
"W-DBS" = "#E41A1C",
"C-qDBS" = "#4DAF4A",
"Plasma" = "#984EA3"
)
)
# You can create additional palettes for other columns, e.g.:
# palette_batch <- create_color_palette(mse, column = "batch")
# palette_donor <- create_color_palette(mse, column = "donor_id", palette = "Set2")
# Display the palette
message("Color palette for sample_type:")
print(palette_sample_type)
#| label: bpc-raw
#| fig-cap: "Base Peak Chromatogram (BPC) of all samples colored by sample type"
# Plot BPC
plot_bpc(mse, palette = palette_sample_type, main = "BPC - All Samples")
#| label: configuration
