#' Calculate the CV values
index_study <- annotated_res$sample_type %in% c("M-VAMS", "W-DBS", "C-qDBS", "Plasma")
index_QC <- annotated_res$sample_type == "QC"
sample_res <- cbind(
QC_raw = rowRsd(assay(annotated_res, "raw_filled")[, index_QC],
na.rm = TRUE, mad = TRUE),
QC_norm = rowRsd(assay(annotated_res, "median_scaling")[, index_QC],
na.rm = TRUE, mad = TRUE),
Study_raw = rowRsd(assay(annotated_res, "raw_filled")[, index_study],
na.rm = TRUE, mad = TRUE),
Study_norm = rowRsd(assay(annotated_res, "median_scaling")[, index_study],
na.rm = TRUE, mad = TRUE)
)
#' Summarize the values across features
res_df <- data.frame(
QC_raw = quantile(sample_res[, "QC_raw"], na.rm = TRUE),
QC_norm = quantile(sample_res[, "QC_norm"], na.rm = TRUE),
Study_raw = quantile(sample_res[, "Study_raw"], na.rm = TRUE),
Study_norm = quantile(sample_res[, "Study_norm"], na.rm = TRUE)
)
kable(res_df, format = "pipe")
res_qc <- annotated_res[, annotated_res$sample_type == "QC"]
res <- annotated_res[, annotated_res$sample_type != "QC"]
## redefine colours for the new data set without QCs
col_sample <- col_sample[names(col_sample) != "QC"]
col_sample_type <- col_sample_type[names(col_sample_type) != "QC"]
#' Calculate the QC's CV and add as feature variable to the data set
rowData(res)$qc_cv <- assay(res_qc, "ISnorm_filled") |>
rowRsd()
#create a logical matrix to be able to make the upsetplot
df_logical <- !is.na(assay(res, "raw_filled"))
# Extract group code (letter before "_pos.mzML")
code <- sub(".*([MWCP])_pos\\.mzML$", "\\1", colnames(df_logical))
# Map codes to descriptive names
code_map <- c(
M = "M-VAMS",
C = "C-qDBS",
W = "W-DBS",
P = "Plasma"
)
groups <- code_map[code]
# Collapse by group using 70% threshold
result <- sapply(unique(groups), function(g) {
# number of samples in this group
n <- sum(groups == g)
# proportion of TRUEs across samples in this group
rowMeans(df_logical[, groups == g, drop = FALSE]) >= 0.7
})
# Result: logical matrix compounds x groups
result[1:5, ]
#make the upsetplot
binary_data <-apply(result, MARGIN = 2, as.integer)
upset(as.data.frame(binary_data), nset = 6, sets = colnames(result), keep.order = TRUE)
#' Define the colors for the plot
col_sample <- col_sample_type[res$sample_type]
#' Log transform and scale the data for PCA analysis
vals <- assay(res, "ISnorm_filled_imputed") |>
t() |>
log2() |>
scale(center = TRUE, scale = TRUE)
pca_res <- prcomp(vals, scale = FALSE, center = FALSE)
vals_st <- cbind(vals, sample_type = res$sample_type)
autoplot(pca_res, data = vals_st , colour = 'sample_type', scale = 0) +
scale_color_manual(values = col_sample_type)
#' Define the linear model to be applied to the data
p.cut <- 0.05     # cut-off for significance.
m.cut <- 0.5      # cut-off for log2 fold change
age <- res$age
sample_type <- factor(res$sample_type)
design <- model.matrix(~ sample_type) ## here need to add  + sex, but that is not in the current metadata..
#' Fit the linear model to the data, explaining metabolite
#' concentrations by phenotype and age.
fit <- lmFit(log2(assay(res, "ISnorm_filled_imputed")), design = design)
fit <- eBayes(fit)
tmp <- data.frame(
coef.vams = fit$coefficients[, "sample_typeM-VAMS"],
pvalue.vams = fit$p.value[, "sample_typeM-VAMS"],
adjp.vams = p.adjust(fit$p.value[, "sample_typeM-VAMS"], method = "BH"),
avg.vams = rowMeans(
log2(assay(res, "ISnorm_filled_imputed")[, res$sample_type == "M-VAMS"])),
avg.CTR = rowMeans(
log2(assay(res, "ISnorm_filled_imputed")[, res$sample_type == "C-qDBS"]))
)
tmp$significant.vams <- tmp$adjp.vams < 0.05
#' Add the results to the object's rowData
rowData(res) <- cbind(rowData(res), tmp)
#' Plot volcano plot of the statistical results
par(mfrow = c(1, 1), mar = c(5, 5, 5, 1))
plot(rowData(res)$coef.vams, -log10(rowData(res)$adjp.vams),
xlab = expression(log[2]~difference),
ylab = expression(-log[10]~p[BH]), pch = 16, col = "#00000060",
cex.main = 1.5, cex.lab = 1.5, cex.axis = 1.3)
grid()
abline(h = -log10(0.05), col = "#0000ffcc")
if (any(rowData(res)$significant.vams)) {
points(rowData(res)$coef.vams[rowData(res)$significant.vams],
-log10(rowData(res)$adjp.vams[rowData(res)$significant.vams]),
col = "#0000ffcc")
}
find(readMsExperiment)
run_plot <- FALSE
