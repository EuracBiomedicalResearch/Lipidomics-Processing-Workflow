median, na.rm = TRUE )
nf_mdn <- mdns / median(mdns)
#' divide dataset by median of median and create a new assay.
assays(annotated_res)$median_scaling <- sweep(assay(annotated_res,
"ISnorm_filled"),
MARGIN = 2, nf_mdn, '/')
assays(annotated_res)$median_scaling_imputed <- sweep(assay(annotated_res,
"ISnorm_filled_imputed"),
MARGIN = 2,
nf_mdn, '/')
